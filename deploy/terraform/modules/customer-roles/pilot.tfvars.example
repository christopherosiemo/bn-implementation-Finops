name                = "finops-pilot"
region              = "eu-west-1"
expected_account_id = "111122223333" # Exact sandbox customer account.
pilot_owner         = "REPLACE-accountable-operator"
pilot_expires_at    = "2026-11-01T18:00:00Z" # Replace with agreed pilot end.
tenant_id           = "REPLACE-exact-oidc-tenant"
read_principal_arn  = "arn:aws:iam::123456789012:role/finops-pilot-ingester"
external_id         = "REPLACE-with-unique-32-character-minimum-value"
billing_bucket_arn  = null # Discovery only; later arn:aws:s3:::YOUR-customer-billing
billing_prefix      = "cur/"
# Trusted billing is separately opt-in; these grant read operations only.
# billing_export_arns           = ["arn:aws:bcm-data-exports:us-east-1:111122223333:export/EXACT-EXISTING-EXPORT"]
# enable_commitment_inventory   = true # Also enable in every linked-account reader.
# Existing bucket must already have versioning and the reviewed writer-boundary
# output policy; this module creates/changes neither bucket nor export.
enable_execution    = false
# Optional native service metadata, each disabled by default. No payload reads.
# enable_ecs_readonly           = true # ECS / Fargate
# enable_eks_readonly           = true # Infrastructure metadata, not Kubernetes access
# enable_elasticache_readonly   = true
# enable_dynamodb_readonly      = true # Table/index metadata, never items
# enable_load_balancer_readonly = true # ALB / NLB / Classic ELB
# aws_service_read_regions     = ["eu-west-1"] # Exact commissioned customer scope
# Add only after read-only acceptance, or retain for an existing live deployment:
# enable_execution        = true
# execution_principal_arn = "arn:aws:iam::123456789012:role/finops-pilot-executor"
# instance_ids            = ["i-0123456789abcdef0"]
