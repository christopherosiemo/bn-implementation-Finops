ARG GO_IMAGE=golang:1.27.2-bookworm
FROM ${GO_IMAGE} AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY cmd ./cmd
COPY internal ./internal
RUN CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" -o /finops ./cmd/finops

FROM debian:bookworm-slim
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates tzdata && rm -rf /var/lib/apt/lists/* && useradd --system --uid 10001 finops
WORKDIR /app
COPY --from=build /finops /app/finops
COPY migrations /app/migrations
USER 10001:10001
EXPOSE 8080
ENTRYPOINT ["/app/finops"]
