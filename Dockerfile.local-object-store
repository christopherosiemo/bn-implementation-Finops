# syntax=docker/dockerfile:1
# Official community registry artifacts for these releases are no longer public.
# Build the unchanged, commit-pinned upstream sources instead of a third-party image.
ARG GO_IMAGE=golang:1.27.2-bookworm
FROM ${GO_IMAGE} AS source-build
ENV CGO_ENABLED=0 GOTOOLCHAIN=local GOMAXPROCS=2
WORKDIR /src

FROM source-build AS minio-build
# RELEASE.2025-04-22T22-12-26Z (peeled annotated tag).
RUN git init . && git remote add origin https://github.com/minio/minio.git \
    && git fetch --depth 1 origin 0d7408fc9969caf07de6a8c3a84f9fbb10a6739e \
    && git checkout --detach FETCH_HEAD \
    && test "$(git rev-parse HEAD)" = 0d7408fc9969caf07de6a8c3a84f9fbb10a6739e
RUN --mount=type=cache,target=/go/pkg/mod,sharing=locked \
    --mount=type=cache,target=/root/.cache/go-build,sharing=locked \
    go build -p 2 -tags kqueue -trimpath \
      -ldflags "$(MINIO_RELEASE=RELEASE go run -p 2 buildscripts/gen-ldflags.go 2025-04-22T22:12:26Z)" \
      -o /out/minio .

FROM source-build AS mc-build
# RELEASE.2025-04-16T18-13-26Z (peeled annotated tag).
RUN git init . && git remote add origin https://github.com/minio/mc.git \
    && git fetch --depth 1 origin b00526b153a31b36767991a4f5ce2cced435ee8e \
    && git checkout --detach FETCH_HEAD \
    && test "$(git rev-parse HEAD)" = b00526b153a31b36767991a4f5ce2cced435ee8e
RUN --mount=type=cache,target=/go/pkg/mod,sharing=locked \
    --mount=type=cache,target=/root/.cache/go-build,sharing=locked \
    go build -p 2 -tags kqueue -trimpath \
      -ldflags "$(MC_RELEASE=RELEASE go run -p 2 buildscripts/gen-ldflags.go 2025-04-16T18:13:26Z)" \
      -o /out/mc .

FROM debian:bookworm-slim AS runtime
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates \
    && rm -rf /var/lib/apt/lists/*
# Keep the official images' root UID so existing local named volumes stay usable.
USER 0:0
WORKDIR /

FROM runtime AS minio
LABEL org.opencontainers.image.source="https://github.com/minio/minio" \
      org.opencontainers.image.revision="0d7408fc9969caf07de6a8c3a84f9fbb10a6739e" \
      org.opencontainers.image.version="RELEASE.2025-04-22T22-12-26Z" \
      org.opencontainers.image.licenses="AGPL-3.0-only"
COPY --from=minio-build /out/minio /usr/local/bin/minio
COPY --from=minio-build /src/LICENSE /src/CREDITS /usr/share/licenses/minio/
EXPOSE 9000 9001
ENTRYPOINT ["/usr/local/bin/minio"]
CMD ["server", "/data"]

FROM runtime AS mc
LABEL org.opencontainers.image.source="https://github.com/minio/mc" \
      org.opencontainers.image.revision="b00526b153a31b36767991a4f5ce2cced435ee8e" \
      org.opencontainers.image.version="RELEASE.2025-04-16T18-13-26Z" \
      org.opencontainers.image.licenses="AGPL-3.0-only"
COPY --from=mc-build /out/mc /usr/local/bin/mc
COPY --from=mc-build /src/LICENSE /src/CREDITS /usr/share/licenses/mc/
ENTRYPOINT ["/usr/local/bin/mc"]
CMD ["--help"]
