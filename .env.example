# Run node scripts/bootstrap.mjs to create .env with independent random service secrets.
# This template is documentation, not a usable production configuration.
COMPOSE_PROJECT_NAME=cloud-cost-autopilot
WEB_PORT=3000
API_PORT=8080
KEYCLOAK_PORT=8081
FIXTURE_MODE=true
POSTGRES_PASSWORD=replace-with-generated-secret
DB_API_PASSWORD=replace-with-generated-secret
DB_WORKER_PASSWORD=replace-with-generated-secret
DB_SIGNER_PASSWORD=replace-with-generated-secret
DB_EXECUTOR_PASSWORD=replace-with-generated-secret
DB_INGESTER_PASSWORD=replace-with-generated-secret
DB_TELEMETRY_READER_PASSWORD=replace-with-generated-secret
DB_TELEMETRY_INGRESS_PASSWORD=replace-with-generated-secret
TELEMETRY_READER_TOKEN=replace-with-generated-secret
TELEMETRY_CLIENT_SECRET=replace-with-generated-secret
# Optional local fleet receipt observer (Compose profile fleet); no apply authority.
DB_DEPLOYMENT_OBSERVER_PASSWORD=replace-with-generated-secret
DB_HARDWARE_READER_PASSWORD=replace-with-generated-secret
# Optional local read-only fleet comparison worker (Compose profile fleet-assessment).
# Bootstrap generates its independent database and versioned-object reader secrets.
DB_GROUP_ASSESSOR_PASSWORD=replace-with-generated-secret
FLEET_ASSESSMENT_DATABASE_URL=postgres://finops_group_assessor:replace-with-generated-secret@postgres:5432/finops?sslmode=disable
ASSESSMENT_ACCESS_KEY=group-assessor
ASSESSMENT_SECRET_KEY=replace-with-generated-secret
# Optional EBS advice. Generate only with FINOPS_BOOTSTRAP_STORAGE_ASSESSOR=true;
# activate separately using the storage-assessment Compose profile.
DB_STORAGE_ANALYST_PASSWORD=
STORAGE_ASSESSOR_ACCESS_KEY=
STORAGE_ASSESSOR_SECRET_KEY=
# Optional S3 advice. Generate only with FINOPS_BOOTSTRAP_OBJECT_STORAGE_ASSESSOR=true;
# activate separately using the object-storage-assessment Compose profile.
DB_OBJECT_STORAGE_ANALYST_PASSWORD=
OBJECT_STORAGE_ASSESSOR_ACCESS_KEY=
OBJECT_STORAGE_ASSESSOR_SECRET_KEY=
# Optional S3 discovery/source commissioning: FINOPS_BOOTSTRAP_S3_READONLY=true.
# Private ingester-only HMAC key and stable version; never share with clients.
S3_OBJECT_IDENTITY_KEY_HEX=
S3_OBJECT_IDENTITY_KEY_VERSION=
DEPLOYMENT_OBSERVER_CLIENT_SECRET=replace-with-generated-secret
SIGNER_TOKEN=replace-with-generated-secret
EXECUTOR_TOKEN=replace-with-generated-secret
ECONOMICS_TOKEN=replace-with-generated-secret
# Optional operator webhook; leave URL empty to retain events in the outbox.
# Live delivery requires HTTPS and a separate signing key; only the worker receives it.
WEBHOOK_URL=
WEBHOOK_SECRET=replace-with-generated-secret
SIGNING_PRIVATE_KEY=generate-base64-ed25519-64-byte-private-key
SIGNING_PUBLIC_KEY=generate-base64-ed25519-32-byte-public-key
MINIO_ROOT_USER=autopilot-local
MINIO_ROOT_PASSWORD=replace-with-generated-secret
OBJECT_ACCESS_KEY=raw-writer
OBJECT_SECRET_KEY=replace-with-generated-secret
AUDIT_ACCESS_KEY=audit-writer
AUDIT_SECRET_KEY=replace-with-generated-secret
CLICKHOUSE_PASSWORD=replace-with-generated-secret
KEYCLOAK_ADMIN_PASSWORD=replace-with-generated-secret
DEMO_USERNAME=owner
DEMO_PASSWORD=local-pilot-demo
# Live mode additionally requires an exact trusted tenant binding and scoped roles.
# AWS_TENANT_ID=your-oidc-tenant-claim
# AWS_READ_ROLE_ARN=arn:aws:iam::CUSTOMER_ACCOUNT:role/finops-read
# AWS_EXECUTION_ROLE_ARN=arn:aws:iam::CUSTOMER_ACCOUNT:role/finops-execution
# AWS_EXTERNAL_ID=customer-specific-external-id

# Optional read-only network ingestion and a separate analytical identity.
# Commission analytical credentials only with FINOPS_BOOTSTRAP_NETWORK_ASSESSOR=true.
NETWORK_READONLY_ENABLED=false
AWS_NETWORK_READ_BINDINGS_JSON=
NETWORK_DATABASE_PASSWORD=
NETWORK_ASSESSOR_ACCESS_KEY=
NETWORK_ASSESSOR_SECRET_KEY=

# Optional existing Lambda telemetry and separate read-only analyst. No function mutations.
LAMBDA_READONLY_ENABLED=false
LAMBDA_COMPUTE_OPTIMIZER_ENABLED=false
AWS_LAMBDA_READ_BINDINGS_JSON=
LAMBDA_DATABASE_PASSWORD=
LAMBDA_ASSESSOR_ACCESS_KEY=
LAMBDA_ASSESSOR_SECRET_KEY=

# Optional ECS/Fargate, DynamoDB, ElastiCache and load-balancer read-only advice.
# Commission only with FINOPS_BOOTSTRAP_SERVICE_ASSESSOR=true; the profile stays off.
SERVICE_DATABASE_PASSWORD=
SERVICE_ASSESSOR_ACCESS_KEY=
SERVICE_ASSESSOR_SECRET_KEY=

# Independent machine performance ingress; commission restricted writer/analytics identities separately.
LAMBDA_PERFORMANCE_ENABLED=false
LAMBDA_PERFORMANCE_OIDC_ISSUER=
LAMBDA_PERFORMANCE_OIDC_AUDIENCE=finops-lambda-performance
LAMBDA_PERFORMANCE_OIDC_JWKS_URL=
LAMBDA_PERFORMANCE_ACCESS_KEY=
LAMBDA_PERFORMANCE_SECRET_KEY=
LAMBDA_PERFORMANCE_CLICKHOUSE_USER=
LAMBDA_PERFORMANCE_CLICKHOUSE_PASSWORD=
