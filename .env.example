# Run node scripts/bootstrap.mjs to create .env with independent random service secrets.
# This template is documentation, not a usable production configuration.
COMPOSE_PROJECT_NAME=cloud-cost-autopilot
WEB_PORT=3000
API_PORT=8080
KEYCLOAK_PORT=8081
FIXTURE_MODE=true
POSTGRES_PASSWORD=replace-with-generated-secret
DB_API_PASSWORD=replace-with-generated-secret
DB_WORKER_PASSWORD=replace-with-generated-secret
DB_SIGNER_PASSWORD=replace-with-generated-secret
DB_EXECUTOR_PASSWORD=replace-with-generated-secret
DB_INGESTER_PASSWORD=replace-with-generated-secret
DB_TELEMETRY_READER_PASSWORD=replace-with-generated-secret
DB_TELEMETRY_INGRESS_PASSWORD=replace-with-generated-secret
TELEMETRY_READER_TOKEN=replace-with-generated-secret
TELEMETRY_CLIENT_SECRET=replace-with-generated-secret
SIGNER_TOKEN=replace-with-generated-secret
EXECUTOR_TOKEN=replace-with-generated-secret
ECONOMICS_TOKEN=replace-with-generated-secret
# Optional operator webhook; leave URL empty to retain events in the outbox.
# Live delivery requires HTTPS and a separate signing key; only the worker receives it.
WEBHOOK_URL=
WEBHOOK_SECRET=replace-with-generated-secret
SIGNING_PRIVATE_KEY=generate-base64-ed25519-64-byte-private-key
SIGNING_PUBLIC_KEY=generate-base64-ed25519-32-byte-public-key
MINIO_ROOT_USER=autopilot-local
MINIO_ROOT_PASSWORD=replace-with-generated-secret
OBJECT_ACCESS_KEY=raw-writer
OBJECT_SECRET_KEY=replace-with-generated-secret
AUDIT_ACCESS_KEY=audit-writer
AUDIT_SECRET_KEY=replace-with-generated-secret
CLICKHOUSE_PASSWORD=replace-with-generated-secret
KEYCLOAK_ADMIN_PASSWORD=replace-with-generated-secret
DEMO_USERNAME=owner
DEMO_PASSWORD=local-pilot-demo
# Live mode additionally requires an exact trusted tenant binding and scoped roles.
# AWS_TENANT_ID=your-oidc-tenant-claim
# AWS_READ_ROLE_ARN=arn:aws:iam::CUSTOMER_ACCOUNT:role/finops-read
# AWS_EXECUTION_ROLE_ARN=arn:aws:iam::CUSTOMER_ACCOUNT:role/finops-execution
# AWS_EXTERNAL_ID=customer-specific-external-id
